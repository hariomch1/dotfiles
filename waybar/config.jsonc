{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
"modules-left": [
    "hyprland/workspaces",
    "temperature"  // This is your CPU Temp
  ],

  "modules-center": [
    "clock"
  ],
"modules-right": [
    "group/tray-expander",
    "network",
    "cpu",
    "memory",
    "custom/batt_temp", // This is your Battery/System Temp
    "battery",
    "bluetooth",
    "pulseaudio"
  ],


  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "on-click": "activate",
    "format": "{name}: {icon}",
    "format-icons": {
      "active": "",
      "default": ""
    }
  },
  "custom/lock": {
    "format": "  ",
    "on-click": "hyprlock",
    "tooltip": true,
    "tooltip-format": "Lock Screen"
  },
  "network": {
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format": "{icon} {essid}",
    "format-wifi": "{icon}  {essid}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "on-click": "alacritty --title 'Network Manager' -e nmtui",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": " Disconnected",
    "interval": 3,
    "spacing": 1
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-discharging": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": {
      "charging": [
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ],
      "default": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{power:>1.0f}W↓",
    "tooltip-format-charging": "{power:>1.0f}W↑",
    "interval": 5,
    "states": {
      "warning": 30,
      "critical": 20
    }
  },
  "pulseaudio": {
    "format": "{icon}{volume}%",
    "format-muted": "󰖁 0%",
    "format-icons": {
      "headphone": "  ",
      "hands-free": "  ",
      "headset": "  ",
      "phone": "  ",
      "portable": "  ",
      "car": "  ",
      "default": [
        " ",
        "  ",
        "  "
      ]
    },
    "on-click-right": "pavucontrol -t 3",
    "on-click": "pactl -- set-sink-mute 0 toggle",
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%"
  },
"temperature": {
    "thermal-zone": 1,
    "critical-threshold": 80,
    "format": " {temperatureC}°C",
    "tooltip": true,
    "tooltip-format": "CPU Package Temp"
  },

  "custom/batt_temp": {
    "exec": "~/.config/waybar/scripts/batt_temp.sh",
    "return-type": "json",
    "interval": 30,
    "format": "{}",
    "tooltip": true
  },
  "memory": {
    "tooltip": true,
    "interval": 30,
    "format": "  {used:0.1f}G/{total:0.1f}G",
    "states": {
      "critical": 90,
      "warning": 70
    }
  },
  "cpu": {
    "interval": 1,
    "format": "  {icon0}{icon1}{icon2}{icon3} {usage:>2}%",
    "format-icons": [
      " ",
      "▂",
      "▃",
      "▄",
      "▅",
      "▆",
      "▇",
      "█"
    ],
    "states": {
      "critical": 90,
      "warning": 70
    }
  },
  "clock": {
    "interval": 1,
    "timezone": "Asia/Kolkata",
    "format": "{:L%A %H:%M %Z}",
    "format-alt": "{:L%d %B %Y}",
    "tooltip": false
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/expand-icon",
      "tray"
    ]
  },
  "custom/expand-icon": {
    "format": " ",
    "tooltip": false
  },
  "tray": {
    "icon-size": 12,
    "spacing": 17
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": " {device_alias}",
    "tooltip-format": "Devices connected: {num_connections}",
    "format-connected-battery": " {device_alias} {device_battery_percentage}%",
    "on-click": "blueman-manager"
  }
}
